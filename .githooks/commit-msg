#!/bin/sh
# The commit message conventions, checked at every commit
# (CODING_STANDARDS.md, "Commits"):
# a nonempty message describes the change, without requiring an issue number;
# a merge says what it brings in, never git's default "Merge branch 'x'";
# and no commit carries a Co-Authored-By trailer. A clone turns it on with
# `make setup` (core.hooksPath); `make commit-msg-selftest` is its test.

msg=$(sed '/^#/d' "$1")
first=$(printf '%s\n' "$msg" | sed -n '/[^[:space:]]/{p;q;}')

fail() {
    printf 'commit-msg: %s\n' "$1" >&2
    printf '  (CODING_STANDARDS.md, "Commits")\n' >&2
    exit 1
}

if printf '%s\n' "$msg" | grep -qi '^co-authored-by:'; then
    fail "a commit carries no Co-Authored-By trailer"
fi

[ -n "$first" ] || fail "describe the change in a nonempty message"

case $first in
    "Merge branch '"*|"Merge remote-tracking branch '"*|"Merge commit '"*|"Merge tag '"*)
        fail "git's default merge message: say what the merge brings in" ;;
esac

exit 0
