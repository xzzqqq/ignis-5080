# Linux serving defaults. CLI, environment and local.mk may override these.
# Keep the measured rtx50-16gb profile in the server as the authority.
CUDA ?= 1
PROFILE ?= release
UI ?= 1
METRICS ?= 1
METRICS_BIND ?=
MODEL ?= qwen3.8-27b-16g
ARTIFACT ?= ./models/qwen3_8_27b_trellis_sc30-v2.ninfer
LANES ?=
BIND ?= 127.0.0.1:8000
LOG_LEVEL ?=
LOG_FORMAT ?=
API_KEY ?=
MAX_CONTEXT ?=
KV_FORMAT ?= hq-e8-2b
PREFILL_CHUNK ?=
DECODE_SHARE ?=
REQUEST_TIMEOUT ?=
STREAM_TIMEOUT ?=
SPEC ?= dflash2
DRAFT_TOKENS ?= 7
DRAFT_HEAD ?=
KV_POOL_BYTES ?=
VRAM_HEADROOM ?=
VRAM_BUDGET ?=
ALLOW_VRAM_OVERSUBSCRIPTION ?=
RETAINED_DEVICE ?=
RETAINED_HOST ?=
VISION ?=
VISION_MAX_TOKENS ?=
ROPE_SCALING ?=
KV_HOST_POOL_BYTES ?= 8G
KV_DISK_BYTES ?=
KV_DISK_PATH ?=
ARGS ?=
GPU_CHECK ?= 1
GPU_THRESHOLD_MIB ?= 8192
# Extra arguments to scripts/gpu_profile.py; --out is required.
GPU_PROFILE_ARGS ?=
READY_TIMEOUT ?= 600
RUNTIME_DIR ?= .scratch/serve
CARGO ?= cargo
NPM ?= npm
CARGO_TARGET_DIR ?= target
