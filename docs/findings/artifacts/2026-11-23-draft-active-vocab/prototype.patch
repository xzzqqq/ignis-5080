+#include <math_constants.h>

 namespace ignis_tl {
 namespace {
+// C1 Kernel Lab experiment: a stable graph reads the current request's bitmap.
+__constant__ uint32_t active_vocab_bits[61];
+__global__ void __launch_bounds__(kThreads, 2) active_draft_kernel(const __grid_constant__ DecodeParams p) {
+  const int cb = blockIdx.x;
+  if (!(active_vocab_bits[cb / 32] & (1u << (cb % 32)))) {
+    // Keep the existing top-k input layout and original token-ID tie break.
+    for (int i = threadIdx.x; i < 7 * 128; i += blockDim.x)
+      p.y[(i / 128) * p.ldy + cb * 128 + i % 128] = __float2bfloat16(-CUDART_INF_F);
+    return;
+  }
+  extern __shared__ __align__(16) unsigned char storage[];
+  __shared__ int last;
+  unit<8, 1>(p, carve(storage, 7), 0, cb, 0, &last);
+}
+
 template <int NG, bool kWide>
 __device__ __forceinline__ void decode_unit(const DecodeParams &p, const Smem &s, int ticket, int *last) {
   const int split = ticket % p.splits;
@@ -97,6 +113,17 @@ template <bool kWide> cudaError_t launch_one(cudaLaunchConfig_t &cfg, int cls, c

 }  // namespace

+extern "C" int ignis_lab_set_vocab_bits(const uint32_t *bits) {
+  return static_cast<int>(cudaMemcpyToSymbol(active_vocab_bits, bits, sizeof(active_vocab_bits)));
+}
+
+int launch_active_draft(const DecodeParams &p, cudaStream_t stream) {
+  if (p.capped || p.splits != 1 || p.tokens != 7 || p.in != 5120 || p.out != 248320 || p.w[0].k2 != 8)
+    return fail("unsupported active draft geometry");
+  active_draft_kernel<<<p.units, kThreads, decode_smem(7), stream>>>(p);
+  return check_launch("active_draft");
+}
